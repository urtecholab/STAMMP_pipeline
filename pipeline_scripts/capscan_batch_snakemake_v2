import glob, os, re

# ── Config ────────────────────────────────────────────────────────────────────
#
# Required via --config (set by run_batched_snakemakes.sh):
#   stammp_dir   Path to the STAMMP install directory
#   output_dir   Project output root (e.g. /home/maholton/scratch/projects/2026_HIV_MASLD_STAMMP)
#   sample_list  Path to file listing all sample names (one per line, no extension)
#   raw_dir      Path to this batch's raw FASTQ directory (one batch_XX/ at a time)
#
# Optional overrides (cluster-specific databases):
#   kraken_db    Path to Kraken2 database
#   bowtie_idx   Path to Bowtie2 index prefix
#   agora_db     Path to AGORA minimap2 index
#   threads      Number of threads (default: 32)

# Auto-detect STAMMP install from snakefile location if not passed explicitly
_snakefile_dir = os.path.dirname(os.path.abspath(workflow.snakefile))
STAMMP_DIR = config.get("stammp_dir", os.path.dirname(_snakefile_dir))

# Project output root — all pipeline outputs live under here
OUTPUT_DIR = config.get("output_dir", os.path.join(os.getcwd(), "stammp_output"))

# Master sample list (all samples across all batches; used for the final merge check)
SAMPLE_LIST = config.get("sample_list", os.path.join(OUTPUT_DIR, "outputs/agora_outputs/sample_list.txt"))

# Raw FASTQ directory for this batch (passed per-batch by run_batched_snakemakes.sh)
RAW_DIR = config.get("raw_dir", "")

# ── Output directories (all absolute, under OUTPUT_DIR) ───────────────────────
AGORA_BASE  = os.path.join(OUTPUT_DIR, "outputs", "agora_outputs")
CLEAN_DIR   = os.path.join(AGORA_BASE, "cleaned")
KRAKEN_DIR  = os.path.join(AGORA_BASE, "kraken_filtered")
BOWTIE_DIR  = os.path.join(AGORA_BASE, "bowtie_filtered")
AGORA_DIR   = os.path.join(AGORA_BASE, "AGORA_mapped")

# ── External databases (cluster-specific; override via --config if needed) ────
KRAKEN_DB        = config.get("kraken_db",  "/mnt/zarrinpar/Pynchon/Databases/kraken2/k2_standard_08_GB_20250714")
BOWTIE_IDX       = config.get("bowtie_idx", "/mnt/zarrinpar/Pynchon/Databases/human_genome/bowtie_CHM13plusY/chm13.draft_v1.0_plusY/chm13.draft_v1.0_plusY")
AGORA_MINIMAP_DB = config.get("agora_db",   "/mnt/zarrinpar/scratch/rrichter/20250120_download_microbiome/db/agora_genomes.idx")
# Threads per rule. With --cores 32 and THREADS=8, Snakemake runs up to 4 samples
# in parallel. Setting THREADS=32 serializes everything (one job fills the budget).
# Override via --config threads=N if your batch size or core count differs.
THREADS          = config.get("threads",    8)

# ── Helper scripts (live inside the STAMMP install — no copies needed) ────────
FILTER_SCRIPTS = os.path.join(STAMMP_DIR, "agora_filter_scripts")

# ── Sample discovery ──────────────────────────────────────────────────────────
with open(SAMPLE_LIST) as f:
    ALL_SAMPLES = [line.strip() for line in f if line.strip()]

MERGE_ONLY = config.get("merge_only", False)

def sample_names():
    files = glob.glob(RAW_DIR + "/*_1.fastq.gz")
    return [re.sub(r"_1\.fastq\.gz$", "", os.path.basename(f)) for f in files]

if MERGE_ONLY:
    SAMPLES = []
    SAMPLES_MISSING = []
else:
    SAMPLES = sample_names()
    SAMPLES_MISSING = [s for s in SAMPLES if not os.path.exists(AGORA_DIR + f"/{s}.counts")]

ALL_SAMPLES_DONE = all(
    os.path.exists(AGORA_DIR + f"/{s}.counts") for s in ALL_SAMPLES
)

# ── Rules ─────────────────────────────────────────────────────────────────────

rule all:
    input:
        expand(AGORA_DIR + "/{sample}.counts", sample=SAMPLES_MISSING),
        *([AGORA_DIR + "/agora_mapped_counts.csv"] if ALL_SAMPLES_DONE and not SAMPLES_MISSING else [])

rule qc_reads:
    input:
        r1 = RAW_DIR + "/{sample}_1.fastq.gz",
        r2 = RAW_DIR + "/{sample}_2.fastq.gz"
    output:
        o1 = CLEAN_DIR + "/{sample}_1.fastq.gz",
        o2 = CLEAN_DIR + "/{sample}_2.fastq.gz"
    threads: THREADS
    shell:
        """
        mkdir -p {CLEAN_DIR}
        fastp \
          -i {input.r1} -I {input.r2} \
          -o {output.o1} -O {output.o2} \
          --thread {threads}
        """

rule bowtie_filter:
    input:
        r1 = CLEAN_DIR + "/{sample}_1.fastq.gz",
        r2 = CLEAN_DIR + "/{sample}_2.fastq.gz"
    output:
        b1 = BOWTIE_DIR + "/{sample}_1.fastq",
        b2 = BOWTIE_DIR + "/{sample}_2.fastq"
    threads: THREADS
    shell:
        """
        mkdir -p {BOWTIE_DIR}
        bowtie2 \
          -x {BOWTIE_IDX} \
          -1 {input.r1} -2 {input.r2} \
          --very-sensitive-local \
          -p {threads} \
          --un-conc {BOWTIE_DIR}/{wildcards.sample}_temp \
          -S /dev/null

        mv {BOWTIE_DIR}/{wildcards.sample}_temp.1 {output.b1}
        mv {BOWTIE_DIR}/{wildcards.sample}_temp.2 {output.b2}

        rm -f {BOWTIE_DIR}/temp.1 {BOWTIE_DIR}/temp.2
        """

rule kraken_classify:
    """Run Kraken2 to classify and generate .kraken and report files"""
    input:
        b1 = BOWTIE_DIR + "/{sample}_1.fastq",
        b2 = BOWTIE_DIR + "/{sample}_2.fastq"
    output:
        kraken = KRAKEN_DIR + "/{sample}.kraken",
        report = KRAKEN_DIR + "/{sample}.report"
    threads: THREADS
    shell:
        """
        mkdir -p {KRAKEN_DIR}
        kraken2 \
          --db {KRAKEN_DB} \
          --paired {input.b1} {input.b2} \
          --output {output.kraken} \
          --report {output.report} \
          --use-names \
          --threads {threads}
        """

rule kraken_extract:
    """Extract non-eukarya reads from .kraken, compress to final FASTQ.gz"""
    input:
        kraken = KRAKEN_DIR + "/{sample}.kraken",
        b1     = BOWTIE_DIR + "/{sample}_1.fastq",
        b2     = BOWTIE_DIR + "/{sample}_2.fastq",
        report = KRAKEN_DIR + "/{sample}.report"
    output:
        u1 = protected(KRAKEN_DIR + "/{sample}_1.fastq.gz"),
        u2 = protected(KRAKEN_DIR + "/{sample}_2.fastq.gz")
    threads: THREADS
    shell:
        """
        python {FILTER_SCRIPTS}/extract_kraken_reads.py \
          -k {input.kraken} \
          -s1 {input.b1} -s2 {input.b2} \
          -r {input.report} \
          -o {KRAKEN_DIR}/{wildcards.sample}_temp_1.fastq \
          -o2 {KRAKEN_DIR}/{wildcards.sample}_temp_2.fastq \
          --taxid 2759 --exclude --include-children --fastq-output

        pigz -p {threads} -c {KRAKEN_DIR}/{wildcards.sample}_temp_1.fastq > {output.u1}
        pigz -p {threads} -c {KRAKEN_DIR}/{wildcards.sample}_temp_2.fastq > {output.u2}

        rm -f {KRAKEN_DIR}/{wildcards.sample}_temp_1.fastq \
              {KRAKEN_DIR}/{wildcards.sample}_temp_2.fastq
        """

rule minimap_agora_count:
    input:
        r1 = KRAKEN_DIR + "/{sample}_1.fastq.gz",
        r2 = KRAKEN_DIR + "/{sample}_2.fastq.gz",
        db = AGORA_MINIMAP_DB
    output:
        AGORA_DIR + "/{sample}.counts"
    threads: THREADS
    shell:
        r"""
        mkdir -p {AGORA_DIR}
        minimap2 -x sr -t {threads} --secondary=no -a {input.db} {input.r1} {input.r2} \
          | samtools view -f 0x42 -F 0xF0C \
          | perl -a -ne '($taxid) = $F[2] =~ /\|([^\|]+)$/; $t{{$taxid}}++ if defined $taxid; END {{ foreach $k (keys %t) {{ print "$k\t$t{{$k}}\n" }} }}' \
          > {output}

        rm -f {CLEAN_DIR}/{wildcards.sample}_1.fastq.gz
        rm -f {CLEAN_DIR}/{wildcards.sample}_2.fastq.gz
        rm -f {BOWTIE_DIR}/{wildcards.sample}_1.fastq
        rm -f {BOWTIE_DIR}/{wildcards.sample}_2.fastq
        """


