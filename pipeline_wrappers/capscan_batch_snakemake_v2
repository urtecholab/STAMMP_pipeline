    RAW_DIR = config.get("raw_dir", "/home/maholton/archive/raw_data/2026/capscan_STAMMP_pipeline/inputs/agora_inputs/batch_01")
    # Samples present in THIS batch's raw dir
    SAMPLES = sample_names()
    # Missing = present in raw dir but no counts yet
    SAMPLES_MISSING = [s for s in SAMPLES if not os.path.exists(AGORA_DIR + f"/{s}.counts")]

